# Documentation only: Django does not automatically load this file.
DEBUG=True
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=
# Leave DATABASE_URL unset locally to use SQLite.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=False
# Preferred existing Render configuration; this URL contains secret credentials.
CLOUDINARY_URL=
# Alternatively omit CLOUDINARY_URL and configure all three separate values:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Gmail delivery, only after owner approval: set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and configure these variables.
# Use a private Google app password when supported; never the account password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=petwell.shop.uk@gmail.com
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# Replace the DEFAULT_FROM_EMAIL value below for Gmail:
# DEFAULT_FROM_EMAIL=PetWell <petwell.shop.uk@gmail.com>
# Legacy SendGrid alternative: default host smtp.sendgrid.net, user apikey.
# SENDGRID_API_KEY is used only for that host when EMAIL_HOST_PASSWORD is unset.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=PetWell <noreply@example.com>
# Optional Mac/local restored-copy profile only; never configure these on Render.
# REHEARSAL_DATABASE_URL=
# REHEARSAL_SECRET_KEY=
